<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StudyAI Pro — Live API & Model Support</title>
  <style>
    /* =========================================
       1. DESIGN TOKENS & THEME
       ========================================= */
    :root {
      --bg-canvas: #090d16;
      --bg-surface: #111827;
      --bg-elevated: #1f2937;
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --accent: #a855f7;
      --danger: #ef4444;
      --success: #10b981;
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --user-bubble: #6366f1;
      --bot-bubble: #1f2937;
      --radius-lg: 16px;
      --radius-md: 12px;
      --radius-pill: 9999px;
      --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-canvas);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 16px;
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(99, 102, 241, 0.09) 0%, transparent 45%),
        radial-gradient(circle at 85% 80%, rgba(168, 85, 247, 0.09) 0%, transparent 45%);
    }

    .chat-container {
      width: 100%;
      max-width: 650px;
      height: 90vh;
      max-height: 820px;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    /* =========================================
       2. HEADER & SETTINGS TRIGGER
       ========================================= */
    .chat-header {
      padding: 16px 24px;
      background-color: rgba(17, 24, 39, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .bot-profile {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-pill);
      background: linear-gradient(135deg, var(--primary), var(--accent));
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .bot-info h1 {
      font-size: 1.05rem;
      font-weight: 600;
    }

    .status {
      font-size: 0.75rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 2px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background-color: var(--success);
      border-radius: 50%;
    }

    .status-dot.offline {
      background-color: #f59e0b;
    }

    .header-actions {
      display: flex;
      gap: 8px;
    }

    .btn-icon {
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 8px 14px;
      border-radius: var(--radius-md);
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .btn-icon:hover {
      background-color: var(--primary);
      border-color: var(--primary);
    }

    /* =========================================
       3. CHAT STREAM & MESSAGES
       ========================================= */
    .chat-messages {
      flex: 1;
      padding: 24px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
      scroll-behavior: smooth;
    }

    .chat-messages::-webkit-scrollbar {
      width: 6px;
    }
    .chat-messages::-webkit-scrollbar-thumb {
      background-color: var(--bg-elevated);
      border-radius: var(--radius-pill);
    }

    .message-wrapper {
      display: flex;
      flex-direction: column;
      max-width: 85%;
      animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .message-wrapper.user {
      align-self: flex-end;
      align-items: flex-end;
    }

    .message-wrapper.bot {
      align-self: flex-start;
      align-items: flex-start;
    }

    .bubble {
      padding: 14px 18px;
      border-radius: var(--radius-md);
      font-size: 0.95rem;
      line-height: 1.55;
      word-wrap: break-word;
      white-space: pre-wrap;
    }

    .user .bubble {
      background-color: var(--user-bubble);
      color: #fff;
      border-bottom-right-radius: 4px;
    }

    .bot .bubble {
      background-color: var(--bot-bubble);
      color: var(--text-main);
      border-bottom-left-radius: 4px;
      border: 1px solid var(--border-subtle);
    }

    .bot.error .bubble {
      border-color: rgba(239, 68, 68, 0.4);
      background-color: rgba(239, 68, 68, 0.1);
      color: #fca5a5;
    }

    .timestamp {
      font-size: 0.68rem;
      color: var(--text-muted);
      margin-top: 5px;
      padding: 0 4px;
    }

    /* =========================================
       4. TYPING INDICATOR
       ========================================= */
    .typing-indicator {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 16px 20px;
      background-color: var(--bot-bubble);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      border-bottom-left-radius: 4px;
      width: fit-content;
    }

    .typing-indicator span {
      width: 6px;
      height: 6px;
      background-color: var(--text-muted);
      border-radius: 50%;
      animation: bounce 1.4s infinite ease-in-out both;
    }

    .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
    .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }

    @keyframes bounce {
      0%, 80%, 100% { transform: scale(0); }
      40% { transform: scale(1); }
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* =========================================
       5. QUICK PROMPTS & COMPOSER
       ========================================= */
    .quick-replies {
      display: flex;
      gap: 8px;
      padding: 10px 24px;
      overflow-x: auto;
      border-top: 1px solid var(--border-subtle);
      background-color: rgba(17, 24, 39, 0.5);
    }

    .quick-replies::-webkit-scrollbar {
      display: none;
    }

    .chip {
      white-space: nowrap;
      background-color: var(--bg-elevated);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .chip:hover {
      background-color: var(--primary);
      border-color: var(--primary);
    }

    .chat-input-area {
      padding: 16px 24px;
      background-color: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .chat-input {
      flex: 1;
      background-color: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-pill);
      padding: 14px 20px;
      color: var(--text-main);
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .chat-input:focus {
      border-color: var(--primary);
    }

    .btn-send {
      width: 46px;
      height: 46px;
      border-radius: var(--radius-pill);
      background-color: var(--primary);
      border: none;
      color: #fff;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .btn-send:hover:not(:disabled) {
      background-color: var(--primary-hover);
    }

    .btn-send:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* =========================================
       6. SETTINGS MODAL OVERLAY
       ========================================= */
    .modal-overlay {
      position: absolute;
      inset: 0;
      background-color: rgba(9, 13, 22, 0.8);
      backdrop-filter: blur(8px);
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 50;
      animation: fadeIn 0.2s ease;
    }

    .modal-overlay.active {
      display: flex;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .modal-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 440px;
      padding: 24px;
      box-shadow: var(--shadow-lg);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .modal-header h2 {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .btn-close {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.4rem;
      cursor: pointer;
      line-height: 1;
    }

    .btn-close:hover {
      color: var(--text-main);
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 6px;
      font-weight: 500;
    }

    .form-control {
      width: 100%;
      background-color: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 11px 14px;
      color: var(--text-main);
      font-size: 0.9rem;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--primary);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 80px;
      font-family: inherit;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 24px;
    }

    .btn-secondary {
      background-color: var(--bg-elevated);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      padding: 10px 16px;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      cursor: pointer;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
    }
  </style>
</head>
<body>

  <main class="chat-container">
    <!-- Header -->
    <header class="chat-header">
      <div class="bot-profile">
        <div class="avatar">AI</div>
        <div class="bot-info">
          <h1>StudyAI Assistant</h1>
          <div class="status">
            <span class="status-dot" id="statusDot"></span>
            <span id="activeModelLabel">No API Key Set (Demo Mode)</span>
          </div>
        </div>
      </div>
      <div class="header-actions">
        <button type="button" class="btn-icon" id="openSettingsBtn" aria-label="Open API Settings">
          ⚙️ Settings
        </button>
        <button type="button" class="btn-icon" id="clearChatBtn" aria-label="Clear Chat">
          🗑️ Clear
        </button>
      </div>
    </header>

    <!-- Chat Stream -->
    <section class="chat-messages" id="chatMessages" aria-live="polite"></section>

    <!-- Study Quick Prompts -->
    <div class="quick-replies" id="quickReplies">
      <button type="button" class="chip" data-prompt="Summarize my study notes in bullet points.">📋 Summarize Notes</button>
      <button type="button" class="chip" data-prompt="Create a 5-question multiple choice quiz from my study material.">✍️ Practice Quiz</button>
      <button type="button" class="chip" data-prompt="Explain the toughest concept from my notes in simple language.">💡 Simplify Concept</button>
    </div>

    <!-- Input Area -->
    <form class="chat-input-area" id="chatForm">
      <input
        type="text"
        id="userInput"
        class="chat-input"
        placeholder="Ask anything about your study material..."
        autocomplete="off"
        required
      />
      <button type="submit" class="btn-send" id="sendBtn" aria-label="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>

    <!-- =========================================
         SETTINGS MODAL (API KEY + MODEL + NOTES)
         ========================================= -->
    <div class="modal-overlay" id="settingsModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-card">
        <div class="modal-header">
          <h2 id="modalTitle">⚙️ API & Model Configuration</h2>
          <button type="button" class="btn-close" id="closeSettingsBtn">×</button>
        </div>

        <form id="settingsForm">
          <!-- API Provider -->
          <div class="form-group">
            <label for="providerSelect">AI Provider</label>
            <select id="providerSelect" class="form-control">
              <option value="gemini">Google Gemini API</option>
              <option value="openai">OpenAI / Compatible API</option>
            </select>
          </div>

          <!-- API Key Input -->
          <div class="form-group">
            <label for="apiKeyInput">API Key</label>
            <input 
              type="password" 
              id="apiKeyInput" 
              class="form-control" 
              placeholder="Paste your API key here (e.g., AIzaSy... or sk-...)" 
            />
          </div>

          <!-- Model Name Input -->
          <div class="form-group">
            <label for="modelInput">Model Name</label>
            <input 
              type="text" 
              id="modelInput" 
              class="form-control" 
              placeholder="e.g., gemini-2.5-flash or gpt-4o-mini" 
            />
          </div>

          <!-- Custom Study Material Context -->
          <div class="form-group">
            <label for="studyContextInput">Your Study Material / Notes (System Context)</label>
            <textarea 
              id="studyContextInput" 
              class="form-control" 
              placeholder="Paste your chapter notes, syllabus, or study text here so the AI answers based on it..."
            ></textarea>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn-secondary" id="cancelSettingsBtn">Cancel</button>
            <button type="submit" class="btn-primary">Save Settings</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    /**
     * Frontend Architecture: Configurable StudyAI Controller
     * Supports dynamic API Key, Model switching, and localStorage persistence.
     */
    class StudyAIApp {
      constructor() {
        // Chat DOM Elements
        this.messagesContainer = document.getElementById('chatMessages');
        this.chatForm = document.getElementById('chatForm');
        this.userInput = document.getElementById('userInput');
        this.sendBtn = document.getElementById('sendBtn');
        this.clearChatBtn = document.getElementById('clearChatBtn');
        this.quickReplies = document.getElementById('quickReplies');
        this.statusDot = document.getElementById('statusDot');
        this.activeModelLabel = document.getElementById('activeModelLabel');

        // Modal DOM Elements
        this.settingsModal = document.getElementById('settingsModal');
        this.openSettingsBtn = document.getElementById('openSettingsBtn');
        this.closeSettingsBtn = document.getElementById('closeSettingsBtn');
        this.cancelSettingsBtn = document.getElementById('cancelSettingsBtn');
        this.settingsForm = document.getElementById('settingsForm');

        // Form Fields
        this.providerSelect = document.getElementById('providerSelect');
        this.apiKeyInput = document.getElementById('apiKeyInput');
        this.modelInput = document.getElementById('modelInput');
        this.studyContextInput = document.getElementById('studyContextInput');

        // State (Loaded from localStorage)
        this.config = this.loadConfig();
        this.conversationHistory = [];

        this.init();
      }

      loadConfig() {
        const saved = localStorage.getItem('study_ai_config');
        return saved ? JSON.parse(saved) : {
          provider: 'gemini',
          apiKey: '',
          model: 'gemini-2.5-flash',
          studyContext: 'You are a helpful study tutor. Help the student understand concepts, create quizzes, and summarize notes clearly.'
        };
      }

      saveConfig(newConfig) {
        this.config = newConfig;
        localStorage.setItem('study_ai_config', JSON.stringify(this.config));
        this.updateStatusUI();
      }

      init() {
        // Chat Events
        this.chatForm.addEventListener('submit', (e) => this.handleSend(e));
        this.clearChatBtn.addEventListener('click', () => this.resetChat());

        this.quickReplies.addEventListener('click', (e) => {
          if (e.target.classList.contains('chip')) {
            this.processMessage(e.target.getAttribute('data-prompt'));
          }
        });

        // Settings Modal Events
        this.openSettingsBtn.addEventListener('click', () => this.openModal());
        this.closeSettingsBtn.addEventListener('click', () => this.closeModal());
        this.cancelSettingsBtn.addEventListener('click', () => this.closeModal());
        this.settingsForm.addEventListener('submit', (e) => this.handleSaveSettings(e));

        // Auto-fill default model name when provider changes
        this.providerSelect.addEventListener('change', () => {
          if (this.providerSelect.value === 'gemini') {
            this.modelInput.value = 'gemini-2.5-flash';
          } else {
            this.modelInput.value = 'gpt-4o-mini';
          }
        });

        this.updateStatusUI();
        this.resetChat();
      }

      openModal() {
        this.providerSelect.value = this.config.provider;
        this.apiKeyInput.value = this.config.apiKey;
        this.modelInput.value = this.config.model;
        this.studyContextInput.value = this.config.studyContext;
        this.settingsModal.classList.add('active');
      }

      closeModal() {
        this.settingsModal.classList.remove('active');
      }

      handleSaveSettings(e) {
        e.preventDefault();
        this.saveConfig({
          provider: this.providerSelect.value,
          apiKey: this.apiKeyInput.value.trim(),
          model: this.modelInput.value.trim() || (this.providerSelect.value === 'gemini' ? 'gemini-2.5-flash' : 'gpt-4o-mini'),
          studyContext: this.studyContextInput.value.trim()
        });
        this.closeModal();
        this.appendMessage(`✅ Settings updated! Active model: ${this.config.model}`, 'bot');
      }

      updateStatusUI() {
        if (this.config.apiKey) {
          this.statusDot.classList.remove('offline');
          this.activeModelLabel.textContent = `${this.config.provider.toUpperCase()} • ${this.config.model}`;
        } else {
          this.statusDot.classList.add('offline');
          this.activeModelLabel.textContent = `Demo Mode (Add API Key in Settings)`;
        }
      }

      resetChat() {
        this.conversationHistory = [];
        this.messagesContainer.innerHTML = '';
        const welcomeMsg = this.config.apiKey
          ? `Hello! Connected to **${this.config.model}**. Paste your study notes in Settings or ask me any question!`
          : `Welcome! Click **⚙️ Settings** at the top right to add your API Key, choose a Model, and paste your study notes.`;
        this.appendMessage(welcomeMsg, 'bot');
      }

      handleSend(e) {
        e.preventDefault();
        const text = this.userInput.value.trim();
        if (!text) return;
        this.userInput.value = '';
        this.processMessage(text);
      }

      async processMessage(text) {
        this.appendMessage(text, 'user');
        this.setInputDisabled(true);
        const typingId = this.showTypingIndicator();

        try {
          let reply = '';
          if (!this.config.apiKey) {
            // Fallback Demo Response if no API Key is set yet
            await new Promise(res => setTimeout(res, 700));
            reply = `⚠️ No API Key configured yet.\n\nClick "⚙️ Settings" in the top bar to enter your API key and select a model (like gemini-2.5-flash or gpt-4o-mini) to get real AI responses for: "${text}"`;
          } else if (this.config.provider === 'gemini') {
            reply = await this.callGeminiAPI(text);
          } else {
            reply = await this.callOpenAIAPI(text);
          }

          this.removeTypingIndicator(typingId);
          this.appendMessage(reply, 'bot');
        } catch (error) {
          this.removeTypingIndicator(typingId);
          this.appendMessage(`❌ API Error: ${error.message}`, 'bot error');
        } finally {
          this.setInputDisabled(false);
          this.userInput.focus();
        }
      }

      /**
       * Live Google Gemini REST API Call
       */
      async callGeminiAPI(prompt) {
        const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(this.config.model)}:generateContent?key=${encodeURIComponent(this.config.apiKey)}`;

        const payload = {
          systemInstruction: {
            parts: [{ text: this.config.studyContext || "You are a helpful study assistant." }]
          },
          contents: [
            { role: "user", parts: [{ text: prompt }] }
          ]
        };

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error?.message || 'Failed to connect to Gemini API');
        }

        return data.candidates?.[0]?.content?.parts?.[0]?.text || 'No response generated.';
      }

      /**
       * Live OpenAI-Compatible REST API Call
       */
      async callOpenAIAPI(prompt) {
        const endpoint = 'https://api.openai.com/v1/chat/completions';

        const payload = {
          model: this.config.model,
          messages: [
            { role: 'system', content: this.config.studyContext || "You are a helpful study assistant." },
            { role: 'user', content: prompt }
          ]
        };

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${this.config.apiKey}`
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error?.message || 'Failed to connect to OpenAI API');
        }

        return data.choices?.[0]?.message?.content || 'No response generated.';
      }

      appendMessage(text, senderClass) {
        const wrapper = document.createElement('div');
        wrapper.className = `message-wrapper ${senderClass}`;

        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.textContent = text;

        const time = document.createElement('span');
        time.className = 'timestamp';
        time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        wrapper.appendChild(bubble);
        wrapper.appendChild(time);
        this.messagesContainer.appendChild(wrapper);
        this.scrollToBottom();
      }

      showTypingIndicator() {
        const id = 'typing-' + Date.now();
        const wrapper = document.createElement('div');
        wrapper.className = 'message-wrapper bot';
        wrapper.id = id;
        wrapper.innerHTML = `<div class="typing-indicator"><span></span><span></span><span></span></div>`;
        this.messagesContainer.appendChild(wrapper);
        this.scrollToBottom();
        return id;
      }

      removeTypingIndicator(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
      }

      setInputDisabled(disabled) {
        this.userInput.disabled = disabled;
        this.sendBtn.disabled = disabled;
      }

      scrollToBottom() {
        this.messagesContainer.scrollTop = this.messagesContainer.scrollHeight;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      new StudyAIApp();
    });
  </script>
</body>
</html>
